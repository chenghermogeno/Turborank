{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Contrast", "color": "#121212" },
				{ "slug": "ink", "name": "Ink", "color": "#0A0A0A" },
				{ "slug": "accent", "name": "Accent", "color": "#F16A4E" },
				{ "slug": "accent-dark", "name": "Accent Dark", "color": "#C8361F" },
				{ "slug": "accent-hover", "name": "Accent Hover", "color": "#EA6C40" },
				{ "slug": "highlight", "name": "Highlight", "color": "#E8FF47" },
				{ "slug": "cream", "name": "Cream", "color": "#F6F1E7" },
				{ "slug": "mist", "name": "Mist", "color": "#EFEDE8" },
				{ "slug": "muted", "name": "Muted", "color": "#A6A8B1" },
				{ "slug": "soft", "name": "Soft", "color": "#F7F6F2" },
				{ "slug": "panel", "name": "Panel", "color": "#1A1A1A" },
				{ "slug": "success", "name": "Success", "color": "#B8E05A" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1080px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "2XS", "size": "8px" },
				{ "slug": "20", "name": "XS", "size": "12px" },
				{ "slug": "30", "name": "S", "size": "20px" },
				{ "slug": "40", "name": "M", "size": "32px" },
				{ "slug": "50", "name": "L", "size": "48px" },
				{ "slug": "60", "name": "XL", "size": "72px" },
				{ "slug": "70", "name": "2XL", "size": "96px" },
				{ "slug": "80", "name": "3XL", "size": "128px" }
			],
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Source Serif 4\", \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
					"name": "Source Serif 4",
					"slug": "serif"
				},
				{
					"fontFamily": "\"Manrope\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"name": "Manrope",
					"slug": "sans"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": { "min": "0.95rem", "max": "1rem" } },
				{ "slug": "large", "name": "Large", "size": "1.125rem", "fluid": { "min": "1.05rem", "max": "1.125rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "xx-large", "name": "2X Large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xxx-large", "name": "3X Large", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } },
				{ "slug": "hero", "name": "Hero", "size": "4.25rem", "fluid": { "min": "2.6rem", "max": "4.25rem" } },
				{ "slug": "display", "name": "Display", "size": "5.5rem", "fluid": { "min": "2.8rem", "max": "5.5rem" } }
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "500",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "500",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--hero)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-dark)"
					}
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"button": {
				"border": {
					"radius": "8px"
				},
				"color": {
					"background": "var(--wp--preset--color--accent-dark)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.8125rem",
					"fontWeight": "700",
					"letterSpacing": "0.02em",
					"textTransform": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"right": "1.35rem",
						"bottom": "0.9rem",
						"left": "1.35rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"typography": {
					"fontWeight": "500"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700",
					"fontSize": "1.05rem",
					"letterSpacing": "-0.02em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.875rem",
					"fontWeight": "500"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"width": "1px",
							"style": "solid"
						},
						"color": {
							"background": "transparent",
							"text": "currentColor"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "blank", "title": "Blank", "postTypes": ["page", "post"] },
		{ "name": "page-contact-2", "title": "Contact 2 (Calendly mock)", "postTypes": ["page"] },
		{ "name": "page-hero-demo-1", "title": "Hero Demo 1", "postTypes": ["page"] },
		{ "name": "page-hero-demo-2", "title": "Hero Demo 2", "postTypes": ["page"] },
		{ "name": "page-hero-demo-3", "title": "Hero Demo 3", "postTypes": ["page"] },
		{ "name": "page-hero-demo-4", "title": "Hero Demo 4", "postTypes": ["page"] },
		{ "name": "single-blog-longform", "title": "Blog — longform (TOC + Discovery)", "postTypes": ["post"] },
		{ "name": "insight-article", "title": "Insight Article", "postTypes": ["page"] },
		{ "name": "insight-longform", "title": "Insight — longform (TOC + Discovery)", "postTypes": ["page"] },
		{ "name": "author-profile", "title": "Author Profile", "postTypes": ["page"] },
		{ "name": "author-profile-alt", "title": "Author Profile (alt layout)", "postTypes": ["page"] },
		{ "name": "page-discovery-snapshot", "title": "Discovery Snapshot document", "postTypes": ["page"] },
		{ "name": "page-webinar-live", "title": "Webinar live", "postTypes": ["page"] }
	]
}
